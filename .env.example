# Copia este archivo como ".env" si quieres que el agente use un LLM real
# en vez del MockProvider (ver core/llm_provider.py).
#
# El proveedor por defecto de cada agente se define en agents/*.json
# ("llm_provider"). Si defines LLM_PROVIDER aqui, sobreescribe ese valor
# sin tener que editar los JSON de configuracion.

LLM_PROVIDER=mock

# Requerida solo si usas LLM_PROVIDER=anthropic (pip install anthropic)
ANTHROPIC_API_KEY=

# Requerida solo si usas LLM_PROVIDER=openai (pip install openai)
OPENAI_API_KEY=
